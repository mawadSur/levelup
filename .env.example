# =============================================================================
# LevelUp AI Academy - Environment Variables
# Copy to .env.local and fill in real values for any service you want to enable.
# Anything left as PLACEHOLDER triggers stub mode for that integration.
# =============================================================================

NODE_ENV=development

# ----- Postgres (with pgvector) ---------------------------------------------
DATABASE_URL=postgresql://levelup:levelup@localhost:5432/levelup?schema=public
SHADOW_DATABASE_URL=postgresql://levelup:levelup@localhost:5432/levelup_shadow?schema=public

# When DATABASE_URL is a transaction-mode pooler (Supabase port 6543, Neon pooled),
# DIRECT_DATABASE_URL must also be set to a non-pooled URL so migrations can use
# prepared statements + DDL. For local docker-compose, leave this unset — Prisma
# falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=

# ── Production: Supabase ─────────────────────────────────────────────────────
# Project Settings → Database → Connection string:
#   DATABASE_URL        = "Transaction" pooler (port 6543)
#     postgres://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_DATABASE_URL = "Session" pooler OR direct (port 5432)
#     postgres://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Enable extensions in Database → Extensions: vector, pg_trgm, pgcrypto.
#
# ── Production: Neon ────────────────────────────────────────────────────────
# DATABASE_URL        = pooled endpoint   (postgres://...-pooler.../neondb?sslmode=require)
# DIRECT_DATABASE_URL = direct endpoint   (postgres://....../neondb?sslmode=require)

# ----- Redis (BullMQ + cache) -----------------------------------------------
REDIS_URL=redis://localhost:6379

# ----- OpenAI (AI coach + assessments) --------------------------------------
OPENAI_API_KEY=PLACEHOLDER_openai_key
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_COACH=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# ----- Supabase Auth --------------------------------------------------------
# Auth provider for the app. Replace with project values from
# Project Settings → API in the Supabase dashboard.
#
# - SUPABASE_URL              project URL (e.g. https://abc123.supabase.co)
# - SUPABASE_ANON_KEY         publishable anon key (browser + server)
# - SUPABASE_SERVICE_ROLE_KEY server-only secret key (bypasses RLS — never ship to web)
# - SUPABASE_JWT_SECRET       optional. Set when project uses legacy HS256
#                             signing; modern projects rely on JWKS.
# - NEXT_PUBLIC_SUPABASE_*    same values, exposed to the browser bundle.
#
# Leaving SUPABASE_URL / SUPABASE_ANON_KEY at the PLACEHOLDER_ defaults
# triggers stub mode: the API exposes /api/auth/dev-bypass for local logins
# without a real Supabase project (NODE_ENV=production refuses to boot in
# stub mode).
SUPABASE_URL=PLACEHOLDER_supabase_url
SUPABASE_ANON_KEY=PLACEHOLDER_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_supabase_service_role_key
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=PLACEHOLDER_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_supabase_anon_key

# ----- Stripe (billing) -----------------------------------------------------
STRIPE_SECRET_KEY=PLACEHOLDER_stripe_secret
STRIPE_WEBHOOK_SECRET=PLACEHOLDER_stripe_webhook

# Per-seat pricing — one Stripe Price per (tier × interval).
#   STARTER : flat $599/mo or $5,990/yr (up to 25 seats)
#   TEAM    : $12/seat/mo or $10/seat/yr (25–100 seats, per-seat metered)
#   GROWTH  : $15/seat/mo or $13/seat/yr (100–500 seats, per-seat metered)
# ENTERPRISE is sales-led — no self-serve price.
STRIPE_PRICE_STARTER_MONTHLY=price_PLACEHOLDER_starter_monthly
STRIPE_PRICE_STARTER_ANNUAL=price_PLACEHOLDER_starter_annual
STRIPE_PRICE_TEAM_MONTHLY=price_PLACEHOLDER_team_monthly
STRIPE_PRICE_TEAM_ANNUAL=price_PLACEHOLDER_team_annual
STRIPE_PRICE_GROWTH_MONTHLY=price_PLACEHOLDER_growth_monthly
STRIPE_PRICE_GROWTH_ANNUAL=price_PLACEHOLDER_growth_annual

# DEPRECATED — use _MONTHLY/_ANNUAL variants. Kept so legacy code that resolves
# only by price ID still maps to the correct Plan; remove once nothing depends.
STRIPE_PRICE_STARTER=price_PLACEHOLDER_starter
STRIPE_PRICE_GROWTH=price_PLACEHOLDER_growth
STRIPE_PRICE_ENTERPRISE=price_PLACEHOLDER_enterprise

# ----- Resend (transactional email) -----------------------------------------
RESEND_API_KEY=PLACEHOLDER_resend_key
RESEND_FROM_EMAIL=hello@levelup.example

# ----- App URLs / ports -----------------------------------------------------
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Auth misc ------------------------------------------------------------
# Supabase manages the session cookie itself; SESSION_SECRET only signs the
# Slack OAuth state. Optional — leave at PLACEHOLDER_ for local dev.
SESSION_SECRET=PLACEHOLDER_at_least_32_random_chars_in_prod
COOKIE_DOMAIN=localhost

# ----- Observability (OpenTelemetry) ---------------------------------------
OTEL_SERVICE_NAME=levelup-api
OTEL_EXPORTER_OTLP_ENDPOINT=PLACEHOLDER_otel_endpoint
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ----- Certificate signing --------------------------------------------------
# SEV-5: keyed HMAC over (userId, learningPathId, issuedAt). Must be at least
# 32 chars. Generate with: `openssl rand -hex 32`. Rotating this value
# invalidates all previously-issued certificates (intentional revocation).
CERT_SIGNING_SECRET=PLACEHOLDER_at_least_32_random_chars_for_cert_hmac

# ----- Analytics (PostHog) --------------------------------------------------
# Server-side key (same project key works for both capture and server-side
# feature flag evaluation). Leave as PLACEHOLDER_ to enable stub mode (all
# captures are no-ops — safe for local dev).
POSTHOG_API_KEY=PLACEHOLDER_posthog_key
POSTHOG_HOST=https://us.i.posthog.com
# Client-side key — safe to expose to the browser (PostHog project public key).
NEXT_PUBLIC_POSTHOG_KEY=PLACEHOLDER_posthog_public_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----- Supabase Storage (certificate PDFs + policy files) -------------------
# Storage uses the same project as Supabase Auth above. When SUPABASE_URL or
# SUPABASE_SERVICE_ROLE_KEY is unset / PLACEHOLDER_, @levelup/storage falls
# back to local filesystem (apps/api/.cert-output/<id>.pdf). See SETUP.md for
# bucket creation.
# Bucket names (override only if you renamed them in the Supabase dashboard).
# SUPABASE_CERTIFICATES_BUCKET=certificates
# SUPABASE_POLICY_FILES_BUCKET=policy-files

# ----- Slack integration -----------------------------------------------------
SLACK_CLIENT_ID=PLACEHOLDER_slack_client_id
SLACK_CLIENT_SECRET=PLACEHOLDER_slack_client_secret
SLACK_SIGNING_SECRET=PLACEHOLDER_slack_signing_secret
INTEGRATION_ENCRYPTION_KEY=PLACEHOLDER_base64_32_byte_key
