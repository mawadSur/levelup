{
  "name": "@levelup/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3000}",
    "build": "next build",
    "postbuild": "[ -n \"$SENTRY_AUTH_TOKEN\" ] && sentry-cli sourcemaps inject ./.next && sentry-cli sourcemaps upload ./.next || echo \"skipping sentry sourcemap upload (SENTRY_AUTH_TOKEN unset)\"",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@levelup/analytics": "workspace:*",
    "@levelup/auth-client": "workspace:*",
    "@levelup/storage": "workspace:*",
    "@levelup/types": "workspace:*",
    "@levelup/ui": "workspace:*",
    "@sentry/nextjs": "^8.40.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "canvas-confetti": "^1.9.3",
    "geist": "^1.7.0",
    "lucide-react": "^0.454.0",
    "motion": "^11.18.2",
    "next": "^15.0.3",
    "next-themes": "^0.4.3",
    "posthog-js": "^1.182.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@levelup/config-eslint": "workspace:*",
    "@levelup/config-tsconfig": "workspace:*",
    "@sentry/cli": "^2.39.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "jsdom": "^25.0.1",
    "msw": "^2.6.4",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
