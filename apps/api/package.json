{
  "name": "@levelup/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && nest build",
    "dev": "rm -rf dist tsconfig.build.tsbuildinfo && nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json"
  },
  "dependencies": {
    "pdfkit": "^0.15.1",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^8.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8",
    "@levelup/db": "workspace:*",
    "@levelup/types": "workspace:*",
    "@levelup/llm": "workspace:*",
    "@levelup/auth-client": "workspace:*",
    "@levelup/billing": "workspace:*",
    "@levelup/queue": "workspace:*",
    "@levelup/storage": "workspace:*",
    "@levelup/observability": "workspace:*",
    "@levelup/analytics": "workspace:*",
    "@levelup/integrations-slack": "workspace:*"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.6",
    "@levelup/config-eslint": "workspace:*",
    "@levelup/config-tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.7",
    "@nestjs/testing": "^10.4.7",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
