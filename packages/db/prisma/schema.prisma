generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Runtime queries: pooled connection (Supabase pgBouncer port 6543, Neon pooled, or local Postgres).
  url        = env("DATABASE_URL")
  // Migrations + Prisma introspect: direct connection (Supabase port 5432, Neon direct).
  // Prepared statements + DDL aren't safe over a transaction-mode pooler, so migrations
  // need a non-pooled URL. Falls back to DATABASE_URL when DIRECT_DATABASE_URL is unset
  // (e.g. local docker-compose where the same connection works for both).
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector, pg_trgm, pgcrypto]
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AiLevel {
  BEGINNER
  PRACTITIONER
  POWER_USER
  CHAMPION
}

enum Plan {
  TRIAL
  STARTER
  TEAM
  GROWTH
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LessonKind {
  READ
  SCENARIO
  LAB
}

enum AssessmentType {
  BASELINE
  FINAL
  CHECKPOINT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum XpEventKind {
  LESSON_COMPLETED
  LESSON_FIRST_TIME
  QUIZ_PASSED_FIRST_TRY
  QUIZ_PASSED_RETRY
  PATH_COMPLETED
  COACH_PROMPT_FIXED
  PROMPT_CLONED
  DAILY_QUEST
  STREAK_7
  STREAK_30
  ASSESSMENT_BASELINE
  BADGE_BONUS
  LAB_PASSED
}

enum QuestStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum DataExportStatus {
  PENDING
  PROCESSING
  READY
  EXPIRED
  FAILED
}

enum DeletionRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PathGenerationStatus {
  PENDING
  GENERATING
  READY
  FAILED
  CANCELLED
}

model Organization {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String?          @unique
  industry             String?
  companySize          String?
  plan                 Plan             @default(TRIAL)
  billingInterval      BillingInterval? @default(MONTHLY)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  stripePriceId        String?
  subscriptionStatus   String?
  planSeats            Int              @default(10)
  trialEndsAt          DateTime?
  archivedAt           DateTime?
  policyText           String?          @db.Text
  paymentFailed        Boolean          @default(false)
  paymentFailedAt      DateTime?
  // EXPANSION #4 — opt out of cross-tenant benchmarking aggregates.
  benchmarkOptOut      Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  users                  User[]
  departments            Department[]
  learningPaths          LearningPath[]
  invitations            Invitation[]
  policies               CompanyPolicy[]
  auditLogs              AuditLog[]
  assessments            Assessment[]
  prompts                Prompt[]
  coachSessions          AiCoachSession[]
  conversations          Conversation[]
  xpEvents               XpEvent[]
  dailyQuests            DailyQuest[]
  reportSnapshots        ReportSnapshot[]
  featureFlags           FeatureFlag[]
  pathGenerationRequests PathGenerationRequest[]
  integrations           OrganizationIntegration[]
  anomalyAlerts          AnomalyAlert[]
  labs                   Lab[]
  incidents              Incident[]
  coachNudges            CoachNudge[]
  labAttempts            LabAttempt[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  invitations     Invitation[]
  reportSnapshots ReportSnapshot[]
  prompts         Prompt[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id              String    @id @default(cuid())
  organizationId  String
  departmentId    String?
  workosUserId    String?   @unique
  supabaseUserId  String?   @unique
  email           String
  name            String
  role            Role      @default(EMPLOYEE)
  jobTitle        String?
  aiLevel         AiLevel   @default(BEGINNER)
  avatarUrl       String?
  lastLoginAt     DateTime?
  deactivatedAt     DateTime?
  leaderboardOptOut Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department             Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  progress               UserProgress[]
  assessments            Assessment[]
  prompts                Prompt[]
  coachSessions          AiCoachSession[]
  certificates           Certificate[]
  badges                 Badge[]
  sentInvitations        Invitation[]             @relation("InvitedBy")
  acceptedInvitations    Invitation[]             @relation("AcceptedBy")
  auditLogs              AuditLog[]
  pathAssignments        LearningPathAssignment[] @relation("AssignedTo")
  pathAssignmentsMade    LearningPathAssignment[] @relation("AssignedBy")
  quizAttempts           QuizAttempt[]
  policiesCreated        CompanyPolicy[]          @relation("PolicyCreatedBy")
  sessions               Session[]
  gameState              UserGameState?
  xpEvents               XpEvent[]
  dailyQuests            DailyQuest[]
  conversations          Conversation[]
  onboarding             UserOnboarding?
  dataExportRequests     DataExportRequest[]
  deletionRequests       DeletionRequest[]
  pathGenerationRequests PathGenerationRequest[]
  installedIntegrations  OrganizationIntegration[]
  anomalyAlerts          AnomalyAlert[]
  acknowledgedAnomalies  AnomalyAlert[]            @relation("AnomalyAcknowledgedBy")
  labAttempts            LabAttempt[]
  userSkills             UserSkill[]
  coachNudges            CoachNudge[]
  incidents              Incident[]                @relation("IncidentActor")
  studyPlans             StudyPlan[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([departmentId])
  @@index([organizationId, role])
  @@map("users")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           Role
  departmentId   String?
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String
  acceptedById   String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

model LearningPath {
  id             String   @id @default(cuid())
  organizationId String?
  title          String
  slug           String
  description    String?  @db.Text
  targetRole     Role?
  targetLevel    AiLevel
  // Tier groups paths in the curriculum map. Mirrors targetLevel today but is
  // kept separate so we can shift the curriculum without rewriting AI-level
  // recommendations elsewhere.
  tier           AiLevel  @default(BEGINNER)
  // Core paths are required for every employee (e.g. AI Basics, Foundations).
  isCore         Boolean  @default(false)
  // Slugs of paths that must be completed before this one unlocks.
  // Stored as JSON string array so the seed + admin UI can edit it cheaply.
  prerequisiteSlugs Json @default("[]")
  coverImageUrl  String?
  isPublished    Boolean  @default(false)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lessons                Lesson[]
  assignments            LearningPathAssignment[]
  certificates           Certificate[]
  pathGenerationRequests PathGenerationRequest[]
  labs                   Lab[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([targetLevel])
  @@index([tier])
  @@map("learning_paths")
}

model LearningPathAssignment {
  id             String   @id @default(cuid())
  learningPathId String
  userId         String
  assignedById   String
  assignedAt     DateTime @default(now())

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  user         User         @relation("AssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User         @relation("AssignedBy", fields: [assignedById], references: [id])

  @@unique([learningPathId, userId])
  @@index([userId])
  @@map("learning_path_assignments")
}

model Lesson {
  id               String   @id @default(cuid())
  learningPathId   String
  title            String
  slug             String
  body             String   @db.Text
  videoUrl         String?
  estimatedMinutes Int
  orderIndex       Int
  kind             LessonKind @default(READ)
  labId            String?    @unique

  learningPath     LearningPath     @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  lab              Lab?             @relation(fields: [labId], references: [id], onDelete: SetNull)
  quizzes          Quiz[]
  progress         UserProgress[]
  contentEmbedding LessonEmbedding?
  sceneAssets      LessonSceneAsset[]
  imageAssets      LessonImageAsset[]
  skills           LessonSkill[]

  @@unique([learningPathId, slug])
  @@index([learningPathId])
  @@map("lessons")
}

/// LessonEmbedding stores OpenAI text-embedding-3-small vectors (1536 dims).
/// `Unsupported("vector(1536)")` is required because Prisma has no first-class
/// pgvector type; we still get the column generated and can query it via
/// `prisma.$queryRaw`. The init migration enables the `vector` extension.
model LessonEmbedding {
  id        String                       @id @default(cuid())
  lessonId  String                       @unique
  embedding Unsupported("vector(1536)")?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_embeddings")
}

model Quiz {
  id       String @id @default(cuid())
  lessonId String
  title    String

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id           String  @id @default(cuid())
  quizId       String
  prompt       String  @db.Text
  choices      Json
  correctIndex Int
  explanation  String? @db.Text
  orderIndex   Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  answers     Json
  score       Int
  passed      Boolean
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model UserProgress {
  id          String       @id @default(cuid())
  userId      String
  lessonId    String
  status      LessonStatus @default(NOT_STARTED)
  score       Int?
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}

model Assessment {
  id                    String         @id @default(cuid())
  organizationId        String
  userId                String
  type                  AssessmentType
  score                 Int
  recommendedLevel      AiLevel
  itemResponses         Json
  assessmentSessionId   String?
  createdAt             DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, assessmentSessionId])
  @@index([organizationId])
  @@index([userId])
  @@map("assessments")
}

model AssessmentItem {
  id             String   @id @default(cuid())
  organizationId String?
  prompt         String   @db.Text
  choices        Json
  correctIndex   Int
  level          AiLevel
  category       String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([level])
  @@index([category])
  @@map("assessment_items")
}

model Prompt {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  departmentId   String?
  title          String
  promptText     String   @db.Text
  category       String
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([category])
  @@index([departmentId])
  @@map("prompts")
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  enabled        Boolean  @default(false)
  rolloutPercent Int?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("feature_flags")
}

model CompanyPolicy {
  id                String   @id @default(cuid())
  organizationId    String
  version           Int      @default(1)
  policyText        String   @db.Text
  uploadedFileUrl   String?
  fileStoragePath   String?
  approvedTools     Json
  createdAt         DateTime @default(now())
  createdById       String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PolicyCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, version(sort: Desc)])
  @@map("company_policies")
}

model AiCoachSession {
  id                     String   @id @default(cuid())
  organizationId         String
  userId                 String
  conversationId         String?
  inputText              String   @db.Text
  aiResponse             String   @db.Text
  category               String?
  sensitiveDataDetected  Boolean  @default(false)
  tokensUsed             Int      @default(0)
  modelUsed              String?
  createdAt              DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
  @@map("ai_coach_sessions")
}

enum TurnRole {
  USER
  ASSISTANT
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns        ConversationTurn[]
  sessions     AiCoachSession[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("conversations")
}

model ConversationTurn {
  id                    String   @id @default(cuid())
  conversationId        String
  role                  TurnRole
  content               String   @db.Text
  sensitiveDataDetected Boolean  @default(false)
  tokensUsed            Int      @default(0)
  modelUsed             String?
  createdAt             DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_turns")
}

model UserOnboarding {
  userId         String    @id
  currentStep    Int       @default(0)
  completedSteps Json      @default("[]")
  dismissedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_onboarding")
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  learningPathId String
  signedHash     String
  pdfUrl         String?
  storagePath    String?
  issuedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
  @@map("certificates")
}

model Badge {
  id          String      @id @default(cuid())
  userId      String
  slug        String
  label       String
  description String?
  iconKey     String?
  rarity      BadgeRarity @default(COMMON)
  xpReward    Int         @default(0)
  awardedAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
  @@map("badges")
}

model UserGameState {
  userId                String    @id
  level                 Int       @default(1)
  xp                    Int       @default(0)
  weeklyXp              Int       @default(0)
  weeklyXpResetAt       DateTime  @default(now())
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastActiveDate        DateTime?
  streakFreezes         Int       @default(0)
  totalLessonsCompleted Int       @default(0)
  totalQuestsCompleted  Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_game_state")
}

model XpEvent {
  id             String      @id @default(cuid())
  userId         String
  organizationId String
  kind           XpEventKind
  xp             Int
  sourceType     String?
  sourceId       String?
  meta           Json?
  createdAt      DateTime    @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, sourceId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("xp_events")
}

model DailyQuest {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  date           DateTime
  quests         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([organizationId, date])
  @@map("daily_quests")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ReportSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  periodStart    DateTime
  periodEnd      DateTime
  payload        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, departmentId, periodStart])
  @@map("report_snapshots")
}

model DataExportRequest {
  id            String           @id @default(cuid())
  userId        String
  status        DataExportStatus @default(PENDING)
  fileUrl       String?
  fileSizeBytes Int?
  expiresAt     DateTime?
  failedReason  String?
  requestedAt   DateTime         @default(now())
  readyAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
  @@map("data_export_requests")
}

model DeletionRequest {
  id           String                @id @default(cuid())
  userId       String
  status       DeletionRequestStatus @default(PENDING)
  scheduledFor DateTime
  reason       String?
  requestedAt  DateTime              @default(now())
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@map("deletion_requests")
}

/// ProcessedWebhookEvent — provider-side idempotency log for webhook deliveries.
///
/// Stripe and WorkOS may redeliver the same event on transient failures. We
/// insert one row per processed event keyed on the provider's natural id
/// (`evt_...` for Stripe, payload `id` for WorkOS). On primary-key conflict
/// the handler short-circuits with a 200 acknowledgement so no side effects
/// (plan changes, audit logs, deactivations) re-apply.
///
/// No FK / no relations: this table is provider-scoped infrastructure.
model ProcessedWebhookEvent {
  id          String   @id // the provider event id (stripe `evt_...` or workos event id)
  provider    String // 'stripe' | 'workos'
  type        String // event type, for analytics/debugging
  processedAt DateTime @default(now())

  @@index([provider, processedAt(sort: Desc)])
  @@map("processed_webhook_events")
}

/// PathGenerationRequest — CR.33 AI-generated custom learning paths.
///
/// One row per admin "build a path with AI" submission. The worker fills in
/// `draft` (the generated structure) and flips `status` to READY. The admin
/// then accepts the draft, which materializes it into real `LearningPath` /
/// `Lesson` / `Quiz` rows and stores the path id in `generatedPathId`.
///
/// `draft` is the canonical store of the LLM output between generation and
/// acceptance — schema-validated against `generatedPathSchema` in `@levelup/llm`.
model PathGenerationRequest {
  id              String               @id @default(cuid())
  organizationId  String
  requestedById   String
  prompt          String               @db.Text
  audience        String?
  status          PathGenerationStatus @default(PENDING)
  failedReason    String?
  generatedPathId String?
  draft           Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy   User          @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  generatedPath LearningPath? @relation(fields: [generatedPathId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status])
  @@map("path_generation_requests")
}

/// DeadLetterJob — failed BullMQ jobs whose retry budget was exhausted.
///
/// Workers attach a `failed` listener that inserts one row per terminally
/// failed job (attemptsMade >= attempts). Operators can then inspect the
/// failures and optionally requeue them out-of-band. The index supports
/// time-ordered listings per job name. No FK to other entities: dead-letter
/// rows are infrastructure-only.
model DeadLetterJob {
  id           String   @id @default(cuid())
  jobName      String
  jobId        String
  attempts     Int
  failedReason String   @db.Text
  data         Json
  createdAt    DateTime @default(now())

  @@index([jobName, createdAt(sort: Desc)])
  @@map("dead_letter_jobs")
}

enum IntegrationProvider {
  SLACK
  MS_TEAMS
}

enum IntegrationStatus {
  ACTIVE
  REVOKED
  ERROR
}

/// OrganizationIntegration — third-party workspace connections (Slack, MS Teams).
///
/// Stores OAuth artifacts per provider per org. The `accessToken` and
/// `botToken` are encrypted at rest by the integrations service before
/// persistence (AES-256-GCM keyed by INTEGRATION_ENCRYPTION_KEY env). The
/// raw tokens are never serialized in API responses; the controller masks them.
model OrganizationIntegration {
  id              String              @id @default(cuid())
  organizationId  String
  provider        IntegrationProvider
  status          IntegrationStatus   @default(ACTIVE)
  externalTeamId  String              // Slack workspace id or Teams tenant id
  externalTeamName String?
  accessToken     String              @db.Text
  botToken        String?             @db.Text
  botUserId       String?
  scopes          String?
  installedById   String
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installedBy  User         @relation(fields: [installedById], references: [id])

  @@unique([organizationId, provider])
  @@index([externalTeamId])
  @@map("organization_integrations")
}

/// AnomalyAlert — proactive risk surface (CR.40).
///
/// Generated by a periodic worker that scans usage patterns. Each alert is
/// scoped to an org + optional user. Severity matches the risk-flag scheme.
enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum AnomalyKind {
  COACH_USAGE_SPIKE
  SENSITIVE_DATA_BURST
  STREAK_BROKEN_AT_RISK
  PATH_BUILDER_ABUSE
  PROMPT_CLONING_ABUSE
}

model AnomalyAlert {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  kind           AnomalyKind
  severity       AnomalySeverity
  signal         Json
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  acknowledger User?        @relation("AnomalyAcknowledgedBy", fields: [acknowledgedBy], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, severity, acknowledgedAt])
  @@map("anomaly_alerts")
}

/// Lab — sandboxed AI scenario for hands-on practice (gamification Sprint 1).
///
/// Each lab has a simulated chatbot (`systemPrompt` + `seededContext`) and a
/// `rubric` that the grader LLM uses to score a learner's transcript. Labs can
/// be global (organizationId NULL) or org-owned; optionally nested under a
/// LearningPath so they participate in path-completion + certificate flow.
///
/// Locked decision: `modelKey` defaults to `gpt-4o-mini` for both simulated
/// chatbot turns and grader evaluation.
model Lab {
  id               String   @id @default(cuid())
  organizationId   String?
  learningPathId   String?
  slug             String   @unique
  title            String
  brief            String   @db.Text
  systemPrompt     String   @db.Text
  seededContext    Json
  rubric           Json
  estimatedMinutes Int
  modelKey         String   @default("gpt-4o-mini")
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  attempts     LabAttempt[]
  lesson       Lesson?
  skills       LabSkill[]
  remediationIncidents Incident[] @relation("IncidentRemediationLab")

  @@index([organizationId])
  @@index([learningPathId])
  @@map("labs")
}

/// LabAttempt — one learner submission against a Lab.
///
/// The grader returns a per-criterion result + overall score. A passing
/// attempt (`passed = true`) triggers `LAB_PASSED` XP via GameService.
model LabAttempt {
  id             String   @id @default(cuid())
  labId          String
  userId         String
  organizationId String
  transcript     Json
  graderRaw      Json
  score          Float
  criteria       Json
  passed         Boolean
  tokensUsed     Int      @default(0)
  createdAt      DateTime @default(now())

  lab          Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, labId])
  @@index([labId, createdAt(sort: Desc)])
  @@map("lab_attempts")
}

/// LessonSceneAsset — pre-generated scene image for narrative scenarios.
///
/// Scenario lessons (kind: scenario) embed branching scenes. At seed time the
/// scenario loader generates one image per scene via Vercel AI Gateway,
/// uploads to Vercel Blob, and persists the URL here. `promptHash` is the
/// SHA-256 of (sceneSlug + scenePrompt + characterSet) — identical content
/// re-seeded reuses the existing blob.
model LessonSceneAsset {
  id         String   @id @default(cuid())
  lessonId   String
  sceneSlug  String
  promptHash String   @unique
  blobUrl    String
  createdAt  DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, sceneSlug])
  @@map("lesson_scene_assets")
}

/// LessonImageAsset — pre-generated image for one `[image]` directive inside
/// a READ-kind lesson's markdown body. `slot` is the zero-based occurrence
/// index of the directive within the body so the renderer can map a directive
/// to its blob URL deterministically. Like LessonSceneAsset, these are global
/// content (the owning Lesson may have a null organizationId).
model LessonImageAsset {
  id         String   @id @default(cuid())
  lessonId   String
  slot       Int
  promptHash String   @unique
  blobUrl    String
  createdAt  DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, slot])
  @@map("lesson_image_assets")
}

// =============================================================================
// EXPANSION #1 — Skill graph + mastery model
// =============================================================================

enum SkillTier {
  BEGINNER
  PRACTITIONER
  POWER_USER
  CHAMPION
}

/// Skill — atomic capability the curriculum teaches.
/// Mostly global content (organizationId = null) but tenants can author
/// org-specific skills (e.g. "Kapitus GLBA compliance").
model Skill {
  id              String     @id @default(cuid())
  organizationId  String?
  slug            String     @unique
  name            String
  description     String?    @db.Text
  tier            SkillTier
  /// Slugs of prerequisite skills. Stored as JSON for cheap admin edits.
  prerequisites   Json       @default("[]")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  userSkills      UserSkill[]
  lessons         LessonSkill[]
  labs            LabSkill[]

  @@index([organizationId])
  @@index([tier])
  @@map("skills")
}

/// LessonSkill — many-to-many between Lesson and Skill.
/// A lesson can teach multiple skills; a skill can be taught by multiple lessons.
model LessonSkill {
  lessonId  String
  skillId   String
  /// 0..1 weight — how much this lesson contributes to the skill (default 1).
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([lessonId, skillId])
  @@index([skillId])
  @@map("lesson_skills")
}

/// LabSkill — many-to-many between Lab and Skill.
/// Lab pass is a stronger "practice" signal than lesson completion.
model LabSkill {
  labId     String
  skillId   String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())

  lab   Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([labId, skillId])
  @@index([skillId])
  @@map("lab_skills")
}

/// UserSkill — per-user mastery across 3 dimensions:
///   exposure: read lessons that teach this skill (0..1)
///   practice: passed labs that teach this skill (0..1)
///   transfer: used the skill in real coach work without triggering sensitive
///             classifier (0..1) — the gold-standard signal
/// Updated by a daily aggregator from XpEvent + LabAttempt + AiCoachSession.
model UserSkill {
  userId    String
  skillId   String
  exposure  Float    @default(0)
  practice  Float    @default(0)
  transfer  Float    @default(0)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

// =============================================================================
// EXPANSION #2 — Proactive coach
// =============================================================================

enum CoachNudgeKind {
  REPEATED_SENSITIVE_PASTE
  PROMPT_PATTERN_STUCK
  UNTOUCHED_SKILL_AFTER_LESSON
  STREAK_AT_RISK
}

/// CoachNudge — system-initiated suggestion to a learner.
/// Generated daily by `generate-coach-nudges` BullMQ cron.
model CoachNudge {
  id                String         @id @default(cuid())
  userId            String
  organizationId    String
  kind              CoachNudgeKind
  body              String         @db.Text
  suggestedTemplate String?        @db.Text
  generatedAt       DateTime       @default(now())
  dismissedAt       DateTime?
  actedOnAt         DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt(sort: Desc)])
  @@index([organizationId, kind, generatedAt(sort: Desc)])
  @@map("coach_nudges")
}

// =============================================================================
// EXPANSION #3 — Incident workflow loop
// =============================================================================

enum IncidentKind {
  SENSITIVE_DATA_LEAK
  POLICY_VIOLATION
  AD_RULE_VIOLATION
  AI_HALLUCINATION_REPORTED
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  REMEDIATED
  DISMISSED
  SUGGESTED
}

/// Incident — auto-generated from classifySensitive triggers above threshold,
/// or manually reported. Closes the compliance loop: detection → assignment →
/// remediation → resolution.
model Incident {
  id                       String           @id @default(cuid())
  organizationId           String
  userId                   String           // actor who triggered
  kind                     IncidentKind
  severity                 IncidentSeverity
  status                   IncidentStatus   @default(OPEN)
  triggeredBy              String           // 'coach' | 'slack' | 'lab' | 'manual'
  signal                   Json             // free-form diagnostic payload
  assignedRemediationLabId String?
  slaDueAt                 DateTime?
  openedAt                 DateTime         @default(now())
  resolvedAt               DateTime?

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User         @relation("IncidentActor", fields: [userId], references: [id], onDelete: Cascade)
  assignedRemediationLab Lab?      @relation("IncidentRemediationLab", fields: [assignedRemediationLabId], references: [id], onDelete: SetNull)

  @@index([organizationId, openedAt(sort: Desc)])
  @@index([organizationId, status, severity])
  @@index([userId, openedAt(sort: Desc)])
  @@map("incidents")
}

// =============================================================================
// EXPANSION #4 — Cross-tenant benchmarking (privacy-preserved aggregate)
// =============================================================================

/// IndustryBenchmarkSnapshot — privacy-preserving quantile snapshot per
/// industry per metric. Recomputed weekly. Hard floor: sampleSize >= 10 orgs
/// AND >= 100 users in the slice before any value is exposed.
model IndustryBenchmarkSnapshot {
  id          String   @id @default(cuid())
  industry    String   // matches Organization.industry
  period      DateTime // ISO week start
  metric      String   // 'lesson_completion_rate' | 'lab_pass_rate' | ...
  sampleSize  Int      // number of orgs contributing
  userSample  Int      // number of users contributing
  p25         Float
  p50         Float
  p75         Float
  p90         Float
  createdAt   DateTime @default(now())

  @@unique([industry, period, metric])
  @@index([industry, metric, period(sort: Desc)])
  @@map("industry_benchmark_snapshots")
}

// =============================================================================
// EXPANSION #5 — Skill-based onboarding (StudyPlan)
// =============================================================================

/// StudyPlan — generated after baseline assessment. One row per week the
/// learner is enrolled. lessonIds / labIds are JSON arrays of target items.
/// Marked complete when all targets are done by `targetCompletionDate`.
model StudyPlan {
  id                    String   @id @default(cuid())
  userId                String
  weekOf                DateTime // start of the ISO week
  lessonIds             Json     // string[]
  labIds                Json     // string[]
  targetCompletionDate  DateTime
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
  @@index([userId, weekOf(sort: Desc)])
  @@map("study_plans")
}
